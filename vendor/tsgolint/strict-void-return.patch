+)
+
+func TestStrictVoidReturnNodePromisify(t *testing.T) {
+	t.Parallel()
+	rule_tester.RunRuleTester(fixtures.GetRootDir(), "tsconfig.includeTypes.json", t, &StrictVoidReturnRule,
+		[]rule_tester.ValidTestCase{
+			{Code: `
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+const run = promisify(execFile);
+const child = run("file").child;
+`},
+			{Code: `
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+const run = promisify<typeof execFile.__promisify__>(execFile);
+const text: Promise<{ stdout: string; stderr: string }> = run("file");
+const bytes: Promise<{ stdout: Buffer; stderr: Buffer }> = run("file", { encoding: "buffer" });
+const child = run("file").child;
+`},
+		},
+		[]rule_tester.InvalidTestCase{
+			{Code: `
+import { execFile } from "node:child_process";
+declare function accept(callback: (file: string) => void): void;
+accept(execFile);
+`, Errors: []rule_tester.InvalidTestCaseError{{MessageId: "nonVoidFunc", Line: 4}}},
+		})
+}
