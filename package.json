{
  "name": "@howells/lint",
  "version": "4.0.0",
  "description": "Pinned Oxlint/Oxfmt, Ultracite, and React Doctor presets for Howells projects.",
  "keywords": [],
  "homepage": "https://github.com/howells/lint#readme",
  "bugs": {
    "url": "https://github.com/howells/lint/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/lint.git"
  },
  "bin": {
    "howells-check": "bin/howells-check.mjs",
    "howells-fix": "bin/howells-fix.mjs",
    "howells-oxfmt": "bin/howells-oxfmt.mjs",
    "howells-oxlint": "bin/howells-oxlint.mjs",
    "howells-workspace-check": "bin/howells-workspace-check.mjs",
    "howells-workspace-fix": "bin/howells-workspace-fix.mjs"
  },
  "files": [
    "oxfmt/*.d.mts",
    "oxfmt/*.mjs",
    "oxlint/*.d.mts",
    "oxlint/*.mjs",
    "bin/*.mjs",
    "vendor/**",
    "docs/**/*.md",
    "README.md",
    "MIGRATIONS.md"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./oxfmt": {
      "types": "./oxfmt/index.d.mts",
      "default": "./oxfmt/index.mjs"
    },
    "./oxlint/core": {
      "types": "./oxlint/core.d.mts",
      "default": "./oxlint/core.mjs"
    },
    "./oxlint/gdp": {
      "types": "./oxlint/gdp.d.mts",
      "default": "./oxlint/gdp.mjs"
    },
    "./oxlint/react": {
      "types": "./oxlint/react.d.mts",
      "default": "./oxlint/react.mjs"
    },
    "./oxlint/next": {
      "types": "./oxlint/next.d.mts",
      "default": "./oxlint/next.mjs"
    },
    "./oxlint/boundaries": {
      "types": "./oxlint/boundaries.d.mts",
      "default": "./oxlint/boundaries.mjs"
    },
    "./oxlint/playwright": {
      "types": "./oxlint/playwright.d.mts",
      "default": "./oxlint/playwright.mjs"
    },
    "./oxlint/react-doctor-rules": {
      "types": "./oxlint/react-doctor-rules.d.mts",
      "default": "./oxlint/react-doctor-rules.mjs"
    },
    "./oxlint/shadcn": {
      "types": "./oxlint/shadcn.d.mts",
      "default": "./oxlint/shadcn.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node bin/howells-oxfmt.mjs --check . && oxlint --deny-warnings bin test oxlint oxfmt oxfmt.config.mjs",
    "lint:fix": "node bin/howells-oxfmt.mjs --write . && oxlint --fix bin scripts test oxlint oxfmt oxfmt.config.mjs",
    "prepare": "howells-husky",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@boundaries/config": "1.0.0",
    "@boundaries/elements": "3.3.1",
    "@boundaries/policies": "1.0.0",
    "@gdp-ts/core": "0.1.0",
    "@manypkg/cli": "0.25.1",
    "chalk": "4.1.2",
    "cn": "0.4.0",
    "eslint-import-resolver-node": "0.3.9",
    "eslint-module-utils": "2.14.0",
    "globals": "17.14.0",
    "oxc-parser": "0.157.0",
    "oxc-resolver": "11.24.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "oxlint-tsgolint": "7.0.2005",
    "stable-hash-x": "0.1.1",
    "ultracite": "8.1.1"
  },
  "devDependencies": {
    "@howells/husky": "^0.3.0",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md,mdx}": "node bin/howells-oxfmt.mjs --write"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.5.2"
}
