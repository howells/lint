{
  "name": "@howells/lint",
  "version": "3.2.5",
  "description": "Pinned Oxlint/Oxfmt, Ultracite, and React Doctor presets for Howells projects.",
  "keywords": [],
  "homepage": "https://github.com/howells/lint#readme",
  "bugs": {
    "url": "https://github.com/howells/lint/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/lint.git"
  },
  "bin": {
    "howells-check": "bin/howells-check.mjs",
    "howells-fix": "bin/howells-fix.mjs",
    "howells-oxfmt": "bin/howells-oxfmt.mjs",
    "howells-oxlint": "bin/howells-oxlint.mjs",
    "howells-ultracite": "bin/howells-ultracite.mjs",
    "howells-workspace-check": "bin/howells-workspace-check.mjs",
    "howells-workspace-fix": "bin/howells-workspace-fix.mjs"
  },
  "files": [
    "oxfmt/*.d.mts",
    "oxfmt/*.mjs",
    "oxlint/*.d.mts",
    "oxlint/*.mjs",
    "bin/*.mjs",
    "vendor/**",
    "docs/**/*.md",
    "CONTEXT.md",
    "README.md",
    "MIGRATIONS.md"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./oxfmt": {
      "types": "./oxfmt/index.d.mts",
      "default": "./oxfmt/index.mjs"
    },
    "./oxlint/core": {
      "types": "./oxlint/core.d.mts",
      "default": "./oxlint/core.mjs"
    },
    "./oxlint/react": {
      "types": "./oxlint/react.d.mts",
      "default": "./oxlint/react.mjs"
    },
    "./oxlint/next": {
      "types": "./oxlint/next.d.mts",
      "default": "./oxlint/next.mjs"
    },
    "./oxlint/boundaries": {
      "types": "./oxlint/boundaries.d.mts",
      "default": "./oxlint/boundaries.mjs"
    },
    "./oxlint/playwright": {
      "types": "./oxlint/playwright.d.mts",
      "default": "./oxlint/playwright.mjs"
    },
    "./oxlint/react-doctor-rules": {
      "types": "./oxlint/react-doctor-rules.d.mts",
      "default": "./oxlint/react-doctor-rules.mjs"
    },
    "./oxlint/neon": {
      "types": "./oxlint/neon.d.mts",
      "default": "./oxlint/neon.mjs"
    },
    "./oxlint/shadcn": {
      "types": "./oxlint/shadcn.d.mts",
      "default": "./oxlint/shadcn.mjs"
    }
  },
  "scripts": {
    "check": "node bin/howells-oxfmt.mjs --check . && oxlint --deny-warnings bin test oxlint oxfmt oxfmt.config.mjs && node --test && pnpm peers check",
    "test": "node --test"
  },
  "dependencies": {
    "@howells/neon": "^0.2.0",
    "@manypkg/cli": "0.25.1",
    "cn": "0.2.6",
    "globals": "17.12.0",
    "oxc-parser": "0.148.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-plugin-react-doctor": "0.9.13",
    "oxlint-tsgolint": "7.0.2001",
    "ultracite": "7.11.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.5.2"
}
