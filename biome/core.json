{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "extends": ["ultracite/biome/core"],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/dist",
      "!!**/build",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/coverage",
      "!!**/storybook-static",
      "!!**/.vercel/output",
      "!!**/out"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
