{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"extends": ["./core.json", "ultracite/biome/react"],
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules/**",
			"!**/.next/**",
			"!**/.turbo/**",
			"!**/.vercel/**",
			"!**/dist/**",
			"!**/build/**",
			"!**/coverage/**",
			"!**/out/**",
			"!**/storybook-static/**",
			"!**/playwright-report/**",
			"!**/test-results/**",
			"!**/.source/**",
			"!**/.cache/**",
			"!**/.expo/**",
			"!**/.output/**",
			"!**/.wrangler/**",
			"!**/.svelte-kit/**",
			"!**/.nuxt/**",
			"!**/.vite/**",
			"!**/.vinxi/**",
			"!**/dev-dist/**",
			"!**/tmp/**",
			"!**/temp/**"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
